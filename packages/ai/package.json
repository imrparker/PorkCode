{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "2.2.5",
  "name": "@opencode/ai",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "bun test --timeout 30000 --only-failures",
    "typecheck": "bun check --no-script && bun check --no-script -p tsconfig.types.json",
    "typecheck:tsc": "tsc --noEmit && tsc --noEmit -p tsconfig.types.json",
    "build": "tsc -p tsconfig.build.json",
    "pack": "bun run script/pack.ts"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect.ts",
    "./testing": "./src/testing.ts",
    "./experimental": "./src/experimental.ts",
    "./route": "./src/route.ts",
    "./providers": "./src/providers.ts",
    "./providers/anthropic-compatible": "./src/providers/anthropic-compatible.ts",
    "./providers/openai-compatible": "./src/providers/openai-compatible.ts",
    "./providers/openai-compatible-responses": "./src/providers/openai-compatible-responses.ts",
    "./providers/openai-compatible/images": "./src/providers/openai-compatible/images.ts",
    "./providers/openai-compatible/responses": "./src/providers/openai-compatible/responses.ts",
    "./protocols": "./src/protocols.ts",
    "./protocols/openai-chat": "./src/protocols/openai-chat.ts",
    "./protocols/openai-images": "./src/protocols/openai-images.ts",
    "./protocols/openai-responses": "./src/protocols/openai-responses.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@opencode/http-recorder": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "3.1057.0",
    "@smithy/eventstream-codec": "4.2.14",
    "@smithy/util-utf8": "4.2.2",
    "@opencode/schema": "workspace:*",
    "aws4fetch": "1.0.20",
    "effect": "catalog:",
    "google-auth-library": "10.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/ai"
  }
}
